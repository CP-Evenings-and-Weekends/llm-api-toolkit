# Copy this file to .env and edit it.
#
# The defaults below point at Ollama on localhost, which is free and needs no
# key. To use OpenAI instead, comment out the Ollama block and uncomment the
# OpenAI block.

LLM_API_URL=http://localhost:11434/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=llama3.2

# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini
